.venv/
__pycache__/
*.pyc
data/cache/
data/raw/*
data/interim/*
data/processed/*
*.duckdb
.pytest_cache/
reports/*.png

# secrets
.env


# The ledger is why the repo is public: committed predictions carry GitHub's
# own commit timestamps, which is a far stronger anchor than "we published a
# page". So the ledger, and the few inputs needed to reproduce a prediction,
# are tracked - about 3MB - while the multi-gigabyte warehouse stays out.
#
# Note the `dir/*` form above rather than `dir/`: git does not descend into an
# excluded DIRECTORY, so a negation inside one never fires. Excluding the
# directory's CONTENTS leaves the path walkable and lets these re-include.
!data/ledger/
!data/ledger/*.jsonl
!data/processed/model_dest_latest.txt
!data/processed/leadtime_roc.json
# The Ethereum side of the same bargain. eth_pit_report.json is the measured
# result, eth_holdout.json names the addresses it was measured on (so anyone can
# re-check a verdict against one the model never saw), and eth_parity_sample.json
# is what `make test` compares the browser's tree-walk against. 130KB for three
# claims that would otherwise have to be taken on trust.
!data/processed/eth_pit_report.json
!data/processed/eth_holdout.json
!data/processed/eth_parity_sample.json
!data/interim/scam_addresses.parquet
!data/raw/tether_blacklist_tron.json

# Build output - regenerated by `make dist`.
dist/

# Build input, not served. index_compact.json is what the page fetches and is
# derived from this; committing both would put 6.4MB of churn in history every
# time the index is rebuilt, for a file no browser requests.
site/address_index.json
.DS_Store
